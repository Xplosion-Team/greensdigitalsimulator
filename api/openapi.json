{
  "openapi": "3.1.0",
  "info": {
    "title": "Greens Digital Twin Brain API",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Read Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/brain/query": {
      "post": {
        "summary": "Brain Query",
        "operationId": "brain_query_v1_brain_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrainQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Brain Query V1 Brain Query Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/brain/sms": {
      "post": {
        "summary": "Sms Reply",
        "description": "Twilio SMS Webhook. Receives text, queries Brain, replies via SMS.",
        "operationId": "sms_reply_v1_brain_sms_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_sms_reply_v1_brain_sms_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_sms_reply_v1_brain_sms_post": {
        "properties": {
          "Body": {
            "type": "string",
            "title": "Body"
          },
          "From": {
            "type": "string",
            "title": "From"
          }
        },
        "type": "object",
        "required": [
          "Body",
          "From"
        ],
        "title": "Body_sms_reply_v1_brain_sms_post"
      },
      "BrainQueryRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "User message"
          },
          "current_glucose": {
            "type": "number",
            "title": "Current Glucose",
            "description": "Current glucose mg/dL"
          },
          "digital_twin_id": {
            "type": "integer",
            "title": "Digital Twin Id",
            "description": "Digital twin ID (0-4)",
            "default": 1
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "Override BRAIN_PROVIDER for this request"
          }
        },
        "type": "object",
        "required": [
          "text",
          "current_glucose"
        ],
        "title": "BrainQueryRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
